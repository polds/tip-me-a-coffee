{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tip-me-a-coffee",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Builds the browser bundles that the ASSETS binding serves.
  "build": { "command": "npm run build" },
  // The Worker runs first for every path, so one app owns routing and CORS on Workers and on Node.
  "assets": { "directory": "./dist/public", "binding": "ASSETS", "run_worker_first": true },
  // The Deploy to Cloudflare button asks for each of these. An empty value means "use the default".
  "vars": {
    "ATUM_ENV": "stub",
    "DEST_ADDRESS": "",
    "DEST_ASSET": "",
    "SOURCE_ASSETS": "",
    "TIP_AMOUNTS": "1,3,5",
    "AUTHOR_NAME": "the author",
    "TIP_MESSAGE": "If this helped, please consider supporting the author.",
    "MARKUP_BPS": "300"
  }
}
