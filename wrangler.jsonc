{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tip-me-a-coffee",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // The browser bundles from `npm run build`. The Worker runs first for every path, so one app
  // owns routing and CORS on Workers and on Node.
  "assets": { "directory": "./dist/public", "binding": "ASSETS", "run_worker_first": true },
  // This file sets no variables, and deploys keep the ones set in the Cloudflare dashboard.
  // A variable named here would be written over the dashboard's value on every deploy.
  "keep_vars": true
}
