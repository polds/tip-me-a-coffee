{
  "name": "tip-me-a-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, embeddable \"Tip me a coffee\" button. Humans and AI agents tip over x402, settled by Atum.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node --watch src/node.ts",
    "dev:worker": "npm run build && wrangler dev",
    "start": "node dist/node.js",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test --test-reporter=spec \"test/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "ethers": "6.17.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@atumlabs/x402-atum-escrow": "0.6.0",
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@x402/core": "2.17.0",
    "@x402/fetch": "2.17.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "wrangler": "4.165.0"
  }
}
